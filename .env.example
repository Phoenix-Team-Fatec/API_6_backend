# Copy this file to .env at the project root, then fill in your values.
#
# Spring Boot 4 uses spring.mongodb.uri (not spring.data.mongodb.uri).
# This variable is read via ${MONGODB_URI} placeholder in application.properties.
#
# On Windows, load into PowerShell before launching VS Code:
#   $env:MONGODB_URI = "mongodb://phoenix:phoenix@mongo:27017/api6?authSource=admin"
#   code <project-folder>
#
# On Linux/Mac, load into host shell before opening the dev container:
#   set -a && source .env && set +a
#   code <project-folder>
#
# Do NOT use: export $(cat .env | xargs) -- MongoDB URIs contain special chars that break xargs parsing
#
# Inside devcontainer (normal workflow -- service name as host):
# MONGODB_URI=mongodb://phoenix:phoenix@mongo:27017/api6?authSource=admin
#
# MongoDB Compass (from host machine):
# mongodb://phoenix:phoenix@localhost:27018/?authSource=admin
#
# On host machine (running mvn spring-boot:run outside Docker):
# MONGODB_URI=mongodb://phoenix:phoenix@localhost:27018/api6?authSource=admin
#
# MongoDB Atlas (staging/production -- copy exact URI from Atlas dashboard):
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/api6?retryWrites=true&w=majority&appName=<cluster>
MONGODB_URI=mongodb://<user>:<pass>@<host>:<port>/<db>?authSource=admin

# AI/ML service used by backend -> IA integrations.
# Current integrations:
# - POST /api/commission/calculate -> POST /commission-algorithm
# - POST /api/rules/generate -> POST /agent
# - /api/ai/* admin proxy routes -> /health and /ingestion/*
# On host machine: http://127.0.0.1:8000
# Inside devcontainer while ML runs on host: http://host.docker.internal:8000
COMMISSION_AI_BASE_URL=http://host.docker.internal:8000
